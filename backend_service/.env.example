# ChatBI 环境样例（SDD-后端 §7.3 全量）。复制为 .env 后按需填写；真实 .env 不提交（B28）。

# ---- LLM（OpenAI 兼容协议；缺 key 时服务照常启动，提问走 SSE error E_LLM_UNAVAILABLE）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
LLM_TIMEOUT_SECONDS=30

# ---- Embedding（可选增强；EMB_* 齐全才启用 exemplar+hnsw，缺失降级 lexical）----
EMB_BASE_URL=
EMB_API_KEY=
EMB_MODEL=
EMB_DIM=1024

# ---- 双数据库（本地 compose；容器内主机名为 db）----
APP_DATABASE_URL=postgresql://app_user:app_password@db:5432/chatbi
ANALYTICS_DATABASE_URL=postgresql://chatbi_ro:chatbi_ro_password@db:5432/chatbi

# ---- 执行层兜底与限幅 ----
QUERY_TIMEOUT_SECONDS=10
ROW_LIMIT_DEFAULT=500
ROW_LIMIT_MAX=1000

# ---- 资源目录（L1 可选增强；缺失也能跑）----
RESOURCES_PATH=/app/algorithm/resources

# ---- 可选：meta_schema_cache 落表开关（默认 false，进程内缓存即可）----
META_SCHEMA_CACHE_ENABLED=false
